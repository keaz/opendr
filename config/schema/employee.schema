# Employee Management Schema
# Version: 1.0
# Author: OpenDR Project
# Date: 2025-01-04
# OID Namespace: 1.2.3.4.5 (EXAMPLE - Replace with your registered PEN)
#
# This schema extends the standard LDAP schema with employee-specific
# attributes and object classes for human resources management.
#
# Prerequisites:
# - Core LDAP schema (RFC 4519)
# - inetOrgPerson object class
#
# Usage:
# 1. Register your own OID namespace (Private Enterprise Number)
# 2. Replace 1.2.3.4.5 with your OID prefix
# 3. Add this schema to your application

################################################################################
# Attribute Type Definitions
################################################################################

# Employee Number
# Unique identifier for employees within the organization
# Format: EMP-XXXXX where X is a digit
# Example: EMP-12345
attributetype ( 1.2.3.4.5.1.1 NAME 'employeeNumber'
    DESC 'Unique employee identification number'
    EQUALITY caseIgnoreMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
    SINGLE-VALUE )

# Department
# Department name or organizational unit code
# Can be multi-valued for employees in multiple departments
# Example: Engineering, Sales, HR
attributetype ( 1.2.3.4.5.1.2 NAME 'department'
    DESC 'Organizational department name or code'
    EQUALITY caseIgnoreMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# Manager
# Distinguished Name of the employee's direct manager
# Must be a valid DN pointing to another person entry
# Example: uid=jsmith,ou=People,dc=example,dc=com
attributetype ( 1.2.3.4.5.1.3 NAME 'manager'
    DESC 'Distinguished name of direct manager'
    EQUALITY distinguishedNameMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.12
    SINGLE-VALUE )

# Job Title
# Employee's job title or position
# Example: Senior Software Engineer, HR Manager
attributetype ( 1.2.3.4.5.1.4 NAME 'title'
    DESC 'Job title or position'
    EQUALITY caseIgnoreMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

# Start Date
# Date when employee started employment
# Format: YYYYMMDD (ISO 8601 basic format)
# Example: 20250104
attributetype ( 1.2.3.4.5.1.5 NAME 'startDate'
    DESC 'Employment start date (YYYYMMDD format)'
    EQUALITY caseIgnoreMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
    SINGLE-VALUE )

# Employee Type
# Type of employment: Full-Time, Part-Time, Contractor, Intern
# Example: Full-Time
attributetype ( 1.2.3.4.5.1.6 NAME 'employeeType'
    DESC 'Type of employment (Full-Time, Part-Time, Contractor, Intern)'
    EQUALITY caseIgnoreMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
    SINGLE-VALUE )

# Cost Center
# Budget or cost center code for accounting purposes
# Example: CC-ENG-2025
attributetype ( 1.2.3.4.5.1.7 NAME 'costCenter'
    DESC 'Cost center or budget code'
    EQUALITY caseIgnoreMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )

################################################################################
# Object Class Definitions
################################################################################

# Employee Object Class
# Extends inetOrgPerson with employee-specific attributes
# Use this for regular employees
#
# Required attributes:
#   - employeeNumber: Unique employee ID
#   - cn: Common name (from person)
#   - sn: Surname (from person)
#
# Optional attributes:
#   - manager: DN of manager
#   - department: Department name(s)
#   - title: Job title
#   - startDate: Employment start date
#   - employeeType: Employment type
#   - costCenter: Cost center code
#   - All inetOrgPerson attributes (uid, mail, etc.)
objectclass ( 1.2.3.4.5.2.1 NAME 'employee'
    DESC 'Employee object class for HR management'
    SUP inetOrgPerson
    STRUCTURAL
    MUST ( employeeNumber )
    MAY ( manager $ department $ title $ startDate $
          employeeType $ costCenter ) )

# Contractor Object Class
# Auxiliary class for contractors and temporary workers
# Can be added to person entries
#
# Use this in addition to person/inetOrgPerson for contractors
objectclass ( 1.2.3.4.5.2.2 NAME 'contractor'
    DESC 'Contractor or temporary worker'
    SUP top
    AUXILIARY
    MAY ( employeeNumber $ department $ title $ startDate $ costCenter ) )

################################################################################
# Usage Examples
################################################################################

# Example 1: Regular Employee Entry
# dn: uid=jdoe,ou=People,dc=example,dc=com
# objectClass: top
# objectClass: person
# objectClass: organizationalPerson
# objectClass: inetOrgPerson
# objectClass: employee
# cn: John Doe
# sn: Doe
# uid: jdoe
# employeeNumber: EMP-12345
# department: Engineering
# title: Senior Software Engineer
# manager: uid=msmith,ou=People,dc=example,dc=com
# startDate: 20200115
# employeeType: Full-Time
# costCenter: CC-ENG-2025
# mail: jdoe@example.com
# telephoneNumber: +1-555-0123

# Example 2: Contractor Entry
# dn: uid=jsmith,ou=People,dc=example,dc=com
# objectClass: top
# objectClass: person
# objectClass: organizationalPerson
# objectClass: inetOrgPerson
# objectClass: contractor
# cn: Jane Smith
# sn: Smith
# uid: jsmith
# employeeNumber: CTR-67890
# department: Marketing
# title: Marketing Consultant
# startDate: 20250101
# mail: jsmith@contractor.example.com

