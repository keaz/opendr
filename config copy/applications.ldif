# Service Account: Backup Service
dn: appId=backup-service,ou=Applications,dc=example,dc=com
objectClass: top
objectClass: serviceAccount
appId: backup-service
cn: Automated Backup Service
description: Daily backup and archival service
appOwner: uid=cgarcia,ou=People,dc=example,dc=com
apiKey: {SSHA512}base64encodedhashedkeyabc
allowedScopes: read:all
allowedScopes: backup:create
rateLimit: 10000
appStatus: active

# Service Account: Monitoring System
dn: appId=monitoring-system,ou=Applications,dc=example,dc=com
objectClass: top
objectClass: serviceAccount
appId: monitoring-system
cn: System Monitoring Service
description: Real-time system health monitoring
appOwner: uid=cgarcia,ou=People,dc=example,dc=com
apiKey: {SSHA512}base64encodedhashedkeydef
allowedScopes: read:metrics
allowedScopes: read:logs
allowedScopes: alert:create
rateLimit: 5000
appStatus: active

# Third-party Integration
dn: appId=slack-integration,ou=Applications,dc=example,dc=com
objectClass: top
objectClass: application
objectClass: oauthClient
appId: slack-integration
cn: Slack Integration
description: Slack workspace integration for notifications
appType: integration
appOwner: uid=ajohnson,ou=People,dc=example,dc=com
appSecret: {SSHA512}base64encodedhashedsecretghi
callbackUrl: https://slack.com/oauth/callback
allowedScopes: read:notifications
allowedScopes: write:messages
rateLimit: 200
appStatus: active

# Development Application (Disabled)
dn: appId=dev-test-app,ou=Applications,dc=example,dc=com
objectClass: top
objectClass: application
