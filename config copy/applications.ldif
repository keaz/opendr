# Sample Application Entries
# This file demonstrates how to use the application schema
# Prerequisites: Application schema must be loaded

# Web Application with OAuth
dn: appId=web-portal,ou=Applications,dc=example,dc=com
objectClass: top
objectClass: application
objectClass: oauthClient
appId: web-portal
cn: Employee Portal
description: Internal employee portal and dashboard
appType: web
appOwner: uid=msmith,ou=People,dc=example,dc=com
appSecret: {SSHA512}base64encodedhashedsecret123
callbackUrl: https://portal.example.com/oauth/callback
callbackUrl: https://portal.example.com/auth/redirect
allowedScopes: read:profile
allowedScopes: read:email
allowedScopes: write:profile
allowedScopes: read:employees
rateLimit: 1000
appStatus: active

# Mobile iOS Application
dn: appId=mobile-ios,ou=Applications,dc=example,dc=com
objectClass: top
objectClass: application
appId: mobile-ios
cn: Company Mobile App (iOS)
description: Official iOS mobile application
appType: mobile-ios
appOwner: uid=bwilson,ou=People,dc=example,dc=com
apiKey: {SSHA512}base64encodedhashedkey456
allowedScopes: read:profile
allowedScopes: read:notifications
allowedScopes: write:feedback
rateLimit: 500
appStatus: active

# Mobile Android Application
dn: appId=mobile-android,ou=Applications,dc=example,dc=com
objectClass: top
objectClass: application
