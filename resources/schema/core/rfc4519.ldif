attributeTypes: ( 2.5.4.10 NAME ( 'o' 'organizationName' ) DESC 'Organization name' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )
