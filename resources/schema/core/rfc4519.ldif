attributeTypes: ( 2.5.4.42 NAME 'givenName' DESC 'Given name' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )
