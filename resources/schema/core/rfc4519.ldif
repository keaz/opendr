attributeTypes: ( 2.5.4.15 NAME 'businessCategory' DESC 'Business category' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )
